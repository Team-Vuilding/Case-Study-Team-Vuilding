APP_NAME=WBA
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://your-api.onrender.com
FRONTEND_URL=https://your-frontend.vercel.app

# Copy these values from Supabase Connect > Session pooler.
DB_CONNECTION=pgsql
DB_HOST=your-session-pooler-host
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-reference
DB_PASSWORD=
DB_SSLMODE=require

LOG_CHANNEL=stderr
LOG_LEVEL=warning
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# Enter only in Render environment settings. Remove after your first successful login.
WBA_ADMIN_NAME=Administrator
WBA_ADMIN_EMAIL=admin@example.com
WBA_ADMIN_PASSWORD=
